# 管理后台认证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_SESSION_SECRET=your_random_secret_string_here

# 发布配置
ADMIN_PUBLISH_CWD=/path/to/project
ADMIN_PUBLISH_COMMAND=npm run build

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key

# 统计与站长平台
NEXT_PUBLIC_GA_ID=G-LH50LSN47W
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
ANALYTICS_DATA_DIR=/root/self-web-host-data
ANALYTICS_HASH_SALT=replace_with_a_random_secret

# 公众号同步（RSSHub、自建 RSS 或其他标准 RSS/Atom 地址）
WECHAT_RSS_URL=
WECHAT_AUTO_PUBLISH=false
