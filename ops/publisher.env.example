# 本机 chatgpt2api。密钥默认从相邻项目的 config.json 读取，无需复制。
CONTENT_AI_BASE_URL=http://127.0.0.1:3000/v1
CONTENT_AI_MODEL=gpt-5-6
CONTENT_AI_REVIEW=true
CONTENT_AUTO_PUBLISH=true

# 微信公众号官方接口。默认从 macOS 钥匙串读取；下面两个变量只作为非 macOS 环境备选。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ARTICLE_AUTHOR=张其来

# true：草稿创建后提交发布；false：只进入公众号草稿箱。
WECHAT_AUTO_PUBLISH=true

# 推荐让公众号 API 从固定公网 IP 的 ECS 发出，并在公众号后台把该 IP 加入白名单。
WECHAT_PUBLISH_HOST=8.149.232.39
WECHAT_PUBLISH_USER=root
WECHAT_PUBLISH_PROJECT_DIR=/root/self-web-host
WECHAT_PUBLISH_SSH_KEY=/absolute/path/to/self-web-host/home.pem
