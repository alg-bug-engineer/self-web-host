# 本机 Google Search Console 凭据：仅保存在本机，不上传到 ECS 或仓库。
SEARCH_CONSOLE_CREDENTIALS_FILE=/absolute/path/to/google-search-console-service-account.json

# ECS 仅接收无凭据的 search-console-latest.json 私有汇总。
SEARCH_CONSOLE_SYNC_REMOTE_HOST=ai-knowledgepoints.cn
SEARCH_CONSOLE_SYNC_REMOTE_USER=root
SEARCH_CONSOLE_SYNC_REMOTE_DIR=/root/self-web-host-data/operator
SEARCH_CONSOLE_SYNC_SSH_KEY=/absolute/path/to/self-web-host/home.pem
